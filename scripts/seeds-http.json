 {
  "name": "chat",
  "ns": "scrap-quilt",
  "description": "Spark, the explainer: ask a question about the live Scrapcraft sheet and get an answer that cites live cell ids (robot.motorL.volts...). Pincher-cached \u2014 the same question in a similar state answers instantly.",
  "signature": {
   "params": {
    "question": {
     "type": "string",
     "description": "Question to ask Spark."
    }
   },
   "returns": "the endpoint's JSON response",
   "aliases": [
    "ask spark",
    "why is my robot slow",
    "explain the sheet"
   ]
  },
  "invoke_kind": "http",
  "invoke_target": {
   "url": "https://scrap-quilt.casey-digennaro.workers.dev/chat",
   "method": "POST"
  },
  "auth_kind": "none",
  "owner": "scrap-quilt"
 },
