[
 {
  "name": "create_organism",
  "ns": "cell-cascade",
  "description": "Creates a new organism with a single totipotent zygote cell. Use when bootstrapping a new differentiation cascade.",
  "signature": {
   "params": {
    "name": {
     "type": "string",
     "description": "Unique name for the organism."
    }
   },
   "returns": "the endpoint's JSON response"
  },
  "invoke_kind": "http",
  "invoke_target": {
   "url": "https://cell-cascade.casey-digennaro.workers.dev/organism",
   "method": "POST"
  },
  "auth_kind": "none",
  "owner": "cell-cascade"
 },
 {
  "name": "list_organisms",
  "ns": "cell-cascade",
  "description": "Lists all organisms in the cascade. Use to discover what organisms exist.",
  "signature": {
   "params": {},
   "returns": "the endpoint's JSON response"
  },
  "invoke_kind": "http",
  "invoke_target": {
   "url": "https://cell-cascade.casey-digennaro.workers.dev/organisms",
   "method": "GET"
  },
  "auth_kind": "none",
  "owner": "cell-cascade"
 },
 {
  "name": "create_cell",
  "ns": "cell-cascade",
  "description": "Performs mitosis: creates a child cell inheriting the parent's character sheet, with a new fate slot (role). Optional tier for early differentiation. Use to grow a cell lineage.",
  "signature": {
   "params": {
    "organism": {
     "type": "string",
     "description": "Name of the organism the cell belongs to."
    },
    "name": {
     "type": "string",
     "description": "Unique name for the new cell."
    },
    "from_cell": {
     "type": "string",
     "description": "Name of the parent cell."
    },
    "role": {
     "type": "string",
     "description": "Fate slot / role for the new cell."
    },
    "tier": {
     "type": "string",
     "description": "Optional early differentiation tier."
    }
   },
   "returns": "the endpoint's JSON response"
  },
  "invoke_kind": "http",
  "invoke_target": {
   "url": "https://cell-cascade.casey-digennaro.workers.dev/cell",
   "method": "POST"
  },
  "auth_kind": "none",
  "owner": "cell-cascade"
 },
 {
  "name": "list_cells",
  "ns": "cell-cascade",
  "description": "Inspects all cells of a given organism. Use to see the current cell population.",
  "signature": {
   "params": {
    "organism": {
     "type": "string",
     "description": "Name of the organism."
    }
   },
   "returns": "the endpoint's JSON response"
  },
  "invoke_kind": "http",
  "invoke_target": {
   "url": "https://cell-cascade.casey-digennaro.workers.dev/cells",
   "method": "GET"
  },
  "auth_kind": "none",
  "owner": "cell-cascade"
 },
 {
  "name": "get_cell",
  "ns": "cell-cascade",
  "description": "Returns a single cell's full detail: signals, myelin paths, fate history, and children. Use to understand a specific cell's state and lineage.",
  "signature": {
   "params": {
    "id": {
     "type": "string",
     "description": "Cell identifier."
    }
   },
   "returns": "the endpoint's JSON response"
  },
  "invoke_kind": "http",
  "invoke_target": {
   "url": "https://cell-cascade.casey-digennaro.workers.dev/cells/{id}",
   "method": "GET"
  },
  "auth_kind": "none",
  "owner": "cell-cascade"
 },
 {
  "name": "send_signal",
  "ns": "cell-cascade",
  "description": "Logs and fires a signal between cells. Sclerotic targets answer deterministically from rule tables (fast/cheap); model tiers think through the model seam (costs logged). Rule-table misses escalate to the germ line and become distillation candidates; myelin counters increment. Use to trigger cell behavior.",
  "signature": {
   "params": {
    "from": {
     "type": "string",
     "description": "Source cell name."
    },
    "to": {
     "type": "string",
     "description": "Target cell name."
    },
    "kind": {
     "type": "string",
     "description": "Signal kind/type."
    },
    "payload": {
     "type": "object",
     "description": "Signal payload data."
    }
   },
   "returns": "the endpoint's JSON response",
   "aliases": [
    "fire a signal",
    "message a cell"
   ]
  },
  "invoke_kind": "http",
  "invoke_target": {
   "url": "https://cell-cascade.casey-digennaro.workers.dev/signal",
   "method": "POST"
  },
  "auth_kind": "none",
  "owner": "cell-cascade"
 },
 {
  "name": "organism_health",
  "ns": "cell-cascade",
  "description": "Reports organism health: tier balance, totipotent load, zero-cost serve percentage, serve-mode split, cost-tumor watch, sclerosis warnings, and myelin hot paths. Use to diagnose performance or cost issues.",
  "signature": {
   "params": {
    "name": {
     "type": "string",
     "description": "Organism name."
    }
   },
   "returns": "the endpoint's JSON response"
  },
  "invoke_kind": "http",
  "invoke_target": {
   "url": "https://cell-cascade.casey-digennaro.workers.dev/organism/{name}/health",
   "method": "GET"
  },
  "auth_kind": "none",
  "owner": "cell-cascade"
 },
 {
  "name": "list_candidates",
  "ns": "cell-cascade",
  "description": "Returns the escalation ledger: every rule-table miss the germ line covered, recorded as a distillation candidate. Use to review what needs distillation.",
  "signature": {
   "params": {
    "name": {
     "type": "string",
     "description": "Organism name."
    }
   },
   "returns": "the endpoint's JSON response"
  },
  "invoke_kind": "http",
  "invoke_target": {
   "url": "https://cell-cascade.casey-digennaro.workers.dev/organism/{name}/candidates",
   "method": "GET"
  },
  "auth_kind": "none",
  "owner": "cell-cascade"
 },
 {
  "name": "resolve_candidate",
  "ns": "cell-cascade",
  "description": "Distills a candidate into a deterministic rule appended to the cell's sheet. Use to convert an escalated case into a fast rule.",
  "signature": {
   "params": {
    "id": {
     "type": "string",
     "description": "Candidate identifier."
    },
    "status": {
     "type": "string",
     "description": "Resolution status."
    },
    "rule": {
     "type": "string",
     "description": "Optional rule to append."
    },
    "evidence_ref": {
     "type": "string",
     "description": "Reference to evidence."
    },
    "gardener_verdict": {
     "type": "string",
     "description": "Gardener's verdict."
    }
   },
   "returns": "the endpoint's JSON response"
  },
  "invoke_kind": "http",
  "invoke_target": {
   "url": "https://cell-cascade.casey-digennaro.workers.dev/candidates/{id}/resolve",
   "method": "POST"
  },
  "auth_kind": "none",
  "owner": "cell-cascade"
 },
