 {
  "name": "post_tick",
  "ns": "scrap-quilt",
  "description": "Game posts cell writes (max 2/sec). Formulas are computed, changed cells appended to the tape, lap detection runs, and updates broadcast to WS subscribers. Use to advance the game state.",
  "signature": {
   "params": {
    "cells": {
     "type": "object",
     "description": "Map of cell names to values, e.g. {\"robot.x\": 29.8}."
    }
   },
   "returns": "the endpoint's JSON response"
  },
  "invoke_kind": "http",
  "invoke_target": {
   "url": "https://scrap-quilt.casey-digennaro.workers.dev/tick",
   "method": "POST"
  },
  "auth_kind": "none",
  "owner": "scrap-quilt"
 },
 {
