 {
  "name": "compile",
  "ns": "tapscript-worker",
  "description": "Compiles TapScript (v1 roman numeral or v2 absolute pitch) to a standard MIDI file. Use to convert notation to playable MIDI.",
  "signature": {
   "params": {
    "notation": {
     "type": "string",
     "description": "TapScript notation string."
    },
    "tempo": {
     "type": "number",
     "description": "Optional tempo in BPM."
    },
    "title": {
     "type": "string",
     "description": "Optional title for the MIDI file."
    }
   },
   "returns": "the endpoint's JSON response"
  },
  "invoke_kind": "http",
  "invoke_target": {
   "url": "https://tapscript-worker.casey-digennaro.workers.dev/compile",
   "method": "POST"
  },
  "auth_kind": "none",
  "owner": "tapscript-worker"
 },
 {
  "name": "parse",
  "ns": "tapscript-worker",
  "description": "Parses TapScript and returns structured info (validity, notes) without rendering. Use to validate or inspect notation.",
  "signature": {
   "params": {
    "notation": {
     "type": "string",
     "description": "TapScript notation string."
    }
   },
   "returns": "the endpoint's JSON response"
  },
  "invoke_kind": "http",
  "invoke_target": {
   "url": "https://tapscript-worker.casey-digennaro.workers.dev/parse",
