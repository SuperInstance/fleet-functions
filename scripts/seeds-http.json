 {
  "name": "query",
  "ns": "fleet-twin",
  "description": "Semantic search over the fleet's embedded corpora; returns ranked chunks with source attribution. Use to find relevant knowledge across the fleet. Ask 'how did the pocket lock last time' class questions of everything the fleet has written. The band's conversation memory: how did the pocket lock last time, what did the crew decide \u2014 ask by meaning.",
  "signature": {
   "params": {
    "text": {
     "type": "string",
     "description": "Query text."
    },
    "topK": {
     "type": "number",
     "description": "Number of top results to return."
    },
    "type": {
     "type": "string",
     "description": "Optional filter by document type."
    },
    "source": {
     "type": "string",
     "description": "Optional filter by source."
    }
   },
   "returns": "the endpoint's JSON response",
   "aliases": [
    "shared memory",
    "what does the fleet remember",
    "pocket lock",
    "fleet memory search"
   ]
  },
  "invoke_kind": "http",
  "invoke_target": {
   "url": "https://fleet-twin.casey-digennaro.workers.dev/query",
   "method": "POST"
  },
  "auth_kind": "none",
  "owner": "fleet-twin"
 },
 {
  "name": "ingest",
